{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alborzframe",
  "compatibility_date": "2026-09-29",
  "main": "./src/index.js",
  "routes": [
    {
      "pattern": "alborzframe.ir",
      "custom_domain": true
    },
    {
      "pattern": "www.alborzframe.ir",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
